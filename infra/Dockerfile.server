# Build stage
FROM golang:1.26-bookworm AS builder

WORKDIR /app
COPY . .

ENV GOTOOLCHAIN=auto

RUN go build -v -o quickcrawl-server ./cmd/server

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/quickcrawl-server /usr/local/bin/quickcrawl-server
COPY quickcrawl.toml /app/quickcrawl.toml

WORKDIR /app

EXPOSE 3000

CMD ["quickcrawl-server"]
