# QuickCrawl environment variables
#
# Copy this file to `.env` and fill in your secrets. .env is gitignored.
# Every variable here overrides the matching TOML value at startup.

# LLM API key used by the JSON extraction format.
# Required only when you call /v1/scrape with formats=["json"] or
# request LLM extraction via the playground / MCP / CLI.
EXTRACTION__LLM__API_KEY=

# Optional LLM overrides (TOML also accepts these).
# EXTRACTION__LLM__MODEL=gpt-4o-mini
# EXTRACTION__LLM__BASE_URL=
# EXTRACTION__LLM__MAX_TOKENS=8192

# Optional renderer override. If empty, the server uses [renderer.chrome].ws_url
# from the TOML. The CLI/MCP auto-launch LightPanda when this is empty.
# RENDERER__CHROME__WS_URL=

# Path to an alternate config file (default: ./quickcrawl.toml).
# CONFIG=/etc/quickcrawl/quickcrawl.toml
